# Settings for deploy/setup.sh. Copy to deploy/lodge.conf (the script does
# it on its first run), fill in, and run the script again. lodge.conf is
# not committed.

# Public address of the wiki. Caddy gets an HTTPS certificate for it
# automatically; its DNS record must point at this server.
# Several names: separate them with commas, e.g.
#   DOMAIN="example.org, www.example.org, me.ddns.net"
# Leave empty to skip Caddy (the wiki then only listens on LISTEN).
DOMAIN=wiki.example.org

# The content repository. The server clones it over SSH with its own deploy
# key, and syncs with it when SYNC=yes. If you are logged in to the GitHub
# CLI (gh), the script adds that key to the repo; otherwise it prints it.
# (An https://github.com/... address is turned into the SSH one.)
# Leave empty to start a new, empty wiki.
DATA_REPO=git@github.com:Castux/lodge-data.git

# Where the content and runtime state live (lodge-data/, lodge-state/).
BASE=/srv/lodge

# Where the wiki listens; Caddy forwards to it. Keep it on 127.0.0.1.
LISTEN=127.0.0.1:8080

TITLE="The Chasers' Lodge"

# Send the Discord notifications in _config/notifications.json (yes/no).
NOTIFY=no

# Sync with DATA_REPO (yes/no): every change made in the wiki is pushed there
# seconds later (GitHub then always holds a copy), and changes pushed there
# from elsewhere (manual edits) are merged into the wiki within 5 minutes,
# or at once with "Sync now" on Recent changes. If a file was changed on
# both sides, the wiki's version wins; admins are told which files.
SYNC=yes

# The system account the wiki runs as.
SERVICE_USER=lodge
